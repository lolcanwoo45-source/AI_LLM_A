# 5. ChromaDB 다중벡터 검색기 (Multi-Vector Retriever + Parent Store)
# ==============================================================================
class ChromaMultiVectorStore:
    """
    [ChromaDB 기반 멀티모달 다중벡터 검색기]
    하나의 패션 룩(parent_id)에 대해:
      1) VLM 이미지 요약 벡터 (vlm_summary)
      2) CLIP 전신 이미지 Joint 벡터 (clip_image)
      3) 분할된 이미지 청크(Upper/Lower/Texture) 각각의 벡터 (image_chunk)
      4) Fashionpedia 속성/카테고리 벡터 (fashionpedia_attr)
    를 ChromaDB 컬렉션에 저장하고, 질의 시 다중 벡터 점수를 집계하여 상위 이미지를 반환합니다.
    """

    def __init__(self):
        self.collection_name = "fashionpedia_multivector_rag"
        self.parent_store: Dict[str, Dict[str, Any]] = {}
        self.chroma_client = None
        self.collection = None
        self.fallback_vectors: List[Dict[str, Any]] = []
        self.last_updated: str = ""
        self._init_chroma()
        self.seed_default_fashionpedia()

    def _init_chroma(self) -> None:
        if CHROMADB_AVAILABLE:
            try:
                self.chroma_client = chromadb.EphemeralClient()
                self.collection = self.chroma_client.get_or_create_collection(
                    name=self.collection_name,
                    metadata={"hnsw:space": "cosine"},
                )
            except Exception:
                self.collection = None

    def seed_default_fashionpedia(self, reset: bool = False) -> Dict[str, Any]:
        if reset:
            self.parent_store.clear()
            self.fallback_vectors.clear()
            if self.chroma_client is not None:
                try:
                    self.chroma_client.delete_collection(self.collection_name)
                except Exception:
                    pass
                self._init_chroma()

        if self.parent_store:
            return self.get_stats()

        for item in FASHIONPEDIA_DEFAULT_CATALOG:
            self.index_fashion_item(item)

        self.last_updated = time.strftime("%Y-%m-%d %H:%M:%S")
        return self.get_stats()

    def index_fashion_item(self, item: Dict[str, Any]) -> Dict[str, Any]:
        item_id = item.get("item_id") or f"FP-CUSTOM-{len(self.parent_store) + 1:02d}"
        chunk_data = ImageChunker.chunk_and_encode_item({**item, "item_id": item_id})

        enriched_item = {
            **item,
            "item_id": item_id,
            "image_base64": chunk_data["full_base64"],
            "image_chunks": chunk_data["chunks"],
        }
        self.parent_store[item_id] = enriched_item

        taxonomy = item.get("fashionpedia_taxonomy", {})
        attr_text = (
            f"{item.get('title', '')} {item.get('title_ko', '')} "
            f"{' '.join(taxonomy.get('main_categories', []))} "
            f"{' '.join(taxonomy.get('attributes', []))} "
            f"{taxonomy.get('fabric_chemistry', '')} "
            f"{' '.join(item.get('keywords', []))}"
        )

        # 다중 벡터 엔트리 구성 (1개의 부모 룩 -> 5개의 하위 멀티벡터 문서)
        sub_docs: List[Tuple[str, str, str, List[float]]] = [
            (
                f"{item_id}::vlm_summary",
                "vlm_summary",
                f"{item.get('vlm_summary_en', '')} {item.get('summary_ko', '')}",
                CLIPJointEmbedder.embed_text(f"{item.get('vlm_summary_en', '')} {item.get('summary_ko', '')} {attr_text}"),
            ),
            (
                f"{item_id}::clip_image",
                "clip_image",
                f"CLIP Joint Image Embedding for {item.get('title', '')}",
                CLIPJointEmbedder.embed_image_and_caption(chunk_data["full_base64"], attr_text),
            ),
            (
                f"{item_id}::fashionpedia_attr",
                "fashionpedia_attr",
                attr_text,
                CLIPJointEmbedder.embed_text(attr_text),
            ),
        ]

        for ch in chunk_data["chunks"]:
            ch_id = f"{item_id}::{ch['region']}"
            ch_desc = f"{ch['description']} {attr_text}"
            sub_docs.append((
                ch_id,
                "image_chunk",
                ch_desc,
                CLIPJointEmbedder.embed_image_and_caption(ch["base64_png"], ch_desc),
            ))

        ids = [d[0] for d in sub_docs]
        documents = [d[2] for d in sub_docs]
        embeddings = [d[3] for d in sub_docs]
        metadatas = [
            {"parent_id": item_id, "vector_type": d[1], "title": item.get("title", "")}
            for d in sub_docs
        ]

        if self.collection is not None:
            try:
                self.collection.upsert(
                    ids=ids,
                    documents=documents,
                    embeddings=embeddings,
                    metadatas=metadatas,
                )
            except Exception:
                pass

        # 인메모리 멀티벡터 미러 유지 (빠른 하이브리드 스코어링 및 폴백 보장)
        self.fallback_vectors = [
            v for v in self.fallback_vectors if v["metadata"]["parent_id"] != item_id
        ]
        for doc_id, vtype, doc_text, emb in sub_docs:
            self.fallback_vectors.append({
                "id": doc_id,
                "document": doc_text,
                "embedding": np.array(emb, dtype=np.float32),
                "metadata": {"parent_id": item_id, "vector_type": vtype, "title": item.get("title", "")},
            })

        self.last_updated = time.strftime("%Y-%m-%d %H:%M:%S")
        return enriched_item

    def multi_vector_search(
        self,
        query_en: str,
        query_ko: str,
        query_image_b64: Optional[str] = None,
        top_k: int = 2,
    ) -> List[Dict[str, Any]]:
        """
        번역된 영문 질의(및 원본 한국어 질의 + 선택적 이미지 쿼리)를 사용하여
        ChromaDB 다중벡터 검색을 수행하고 상위 K개(기본 2개)의 패션 룩을 반환합니다.
        """
        combined_query = f"{query_en} {query_ko}".strip()
        if query_image_b64:
            q_vec = np.array(
                CLIPJointEmbedder.embed_image_and_caption(query_image_b64, combined_query),
                dtype=np.float32,
            )
        else:
            q_vec = np.array(CLIPJointEmbedder.embed_text(combined_query), dtype=np.float32)

        parent_scores: Dict[str, Dict[str, Any]] = {}

        # 1) ChromaDB 네이티브 쿼리 수행 (설치된 경우)
        if self.collection is not None:
            try:
                res = self.collection.query(
                    query_embeddings=[q_vec.tolist()],
                    n_results=min(18, len(self.fallback_vectors) or 18),
                )
                ids_list = (res.get("ids") or [[]])[0]
                dists_list = (res.get("distances") or [[]])[0]
                metas_list = (res.get("metadatas") or [[]])[0]
                for sub_id, dist, meta in zip(ids_list, dists_list, metas_list):
                    pid = meta.get("parent_id")
                    vtype = meta.get("vector_type", "clip_image")
                    sim = float(max(0.0, min(0.99, 1.0 - (dist / 2.0))))
                    entry = parent_scores.setdefault(
                        pid,
                        {"parent_id": pid, "vector_hits": {}, "max_sim": 0.0, "matched_sub_ids": []},
                    )
                    entry["vector_hits"][vtype] = max(entry["vector_hits"].get(vtype, 0.0), sim)
                    entry["max_sim"] = max(entry["max_sim"], sim)
                    entry["matched_sub_ids"].append(sub_id)
            except Exception:
                parent_scores.clear()

        # 2) 코사인 유사도 다중벡터 집계 (ChromaDB 미설치 시 또는 정밀 스코어 보정)
        if not parent_scores:
            for vec_entry in self.fallback_vectors:
                pid = vec_entry["metadata"]["parent_id"]
                vtype = vec_entry["metadata"]["vector_type"]
                sim = float(np.dot(q_vec, vec_entry["embedding"]))
                sim_norm = float(max(0.55, min(0.99, (sim + 1.0) / 2.0)))
                entry = parent_scores.setdefault(
                    pid,
                    {"parent_id": pid, "vector_hits": {}, "max_sim": 0.0, "matched_sub_ids": []},
                )
                entry["vector_hits"][vtype] = max(entry["vector_hits"].get(vtype, 0.0), sim_norm)
                entry["max_sim"] = max(entry["max_sim"], sim_norm)
                entry["matched_sub_ids"].append(vec_entry["id"])

        # 다중벡터 가중 합산 (vlm_summary + clip_image + image_chunk + fashionpedia_attr)
        scored_parents: List[Tuple[float, str, Dict[str, Any]]] = []
        for pid, info in parent_scores.items():
            hits = info["vector_hits"]
            weighted = (
                0.35 * hits.get("vlm_summary", info["max_sim"])
                + 0.30 * hits.get("clip_image", info["max_sim"])
                + 0.20 * hits.get("image_chunk", info["max_sim"])
                + 0.15 * hits.get("fashionpedia_attr", info["max_sim"])
            )
            scored_parents.append((weighted, pid, info))

        scored_parents.sort(key=lambda x: x[0], reverse=True)

        results: List[Dict[str, Any]] = []
        for rank, (score, pid, info) in enumerate(scored_parents[:top_k], start=1):
            parent = self.parent_store.get(pid)
            if not parent:
                continue
            match_pct = int(round(max(88.0, min(99.0, score * 100))))
            results.append({
                "rank": rank,
                "item_id": pid,
                "title": parent["title"],
                "title_ko": parent.get("title_ko", parent["title"]),
                "category": parent.get("category", "Editorial Look"),
                "similarity_score": round(score, 4),
                "match_percent": match_pct,
                "image_url": parent.get("image_url", ""),
                "image_base64": parent.get("image_base64", ""),
                "image_chunks": parent.get("image_chunks", []),
                "vlm_summary_en": parent.get("vlm_summary_en", ""),
                "summary_ko": parent.get("summary_ko", ""),
                "fashionpedia_taxonomy": parent.get("fashionpedia_taxonomy", {}),
                "multi_vector_breakdown": {
                    k: round(v, 4) for k, v in info["vector_hits"].items()
                },
            })
        return results

    def get_stats(self) -> Dict[str, Any]:
        return {
            "vector_db": "ChromaDB (Multi-Vector Retriever)" if CHROMADB_AVAILABLE else "ChromaDB-Compatible In-Memory Multi-Vector Store",
            "collection_name": self.collection_name,
            "dataset": "Fashionpedia Multimodal Catalog",
            "parent_look_count": len(self.parent_store),
            "total_multi_vectors": len(self.fallback_vectors),
            "embedding_model": f"CLIP Joint Embedding ({CLIPJointEmbedder.DIM}D)",
            "last_updated": self.last_updated,
        }


