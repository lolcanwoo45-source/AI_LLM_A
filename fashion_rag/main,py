# 1. 실시간 스트리밍 및 파이프라인 상태 추적 핸들러 (StreamHandler)
# ==============================================================================
class StreamHandler:
    """파이프라인 단계별 진행률, 소요 시간(ms), 알고리즘 복잡도를 기록합니다."""

    def __init__(self, pipeline_name: str):
        self.pipeline_name = pipeline_name
        self.start_time = time.perf_counter()
        self.events: List[Dict[str, Any]] = []

    def emit(
        self,
        step: str,
        message: str,
        status: str = "RUNNING",
        progress: int = 0,
        time_complexity: str = "O(1)",
        space_complexity: str = "O(1)",
        details: Optional[Dict[str, Any]] = None,
    ) -> Dict[str, Any]:
        elapsed_ms = round((time.perf_counter() - self.start_time) * 1000, 2)
        event = {
            "pipeline": self.pipeline_name,
            "step": step,
            "message": message,
            "status": status,
            "progress": max(0, min(100, progress)),
            "elapsed_ms": elapsed_ms,
            "complexity": {"time": time_complexity, "space": space_complexity},
            "details": details or {},
            "timestamp": time.strftime("%Y-%m-%d %H:%M:%S"),
        }
        self.events.append(event)
        return event

    def get_summary(self) -> Dict[str, Any]:
        total_ms = round((time.perf_counter() - self.start_time) * 1000, 2)
        return {
            "pipeline": self.pipeline_name,
            "total_elapsed_ms": total_ms,
            "step_count": len(self.events),
            "events": self.events,
        }


