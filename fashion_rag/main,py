                        "accessory": "부드러운 스웨이드 로퍼와 장식을 최소화한 레더 벨트, 브러시드 골드 미니멀 워치를 매치하여 절제된 콰이어트 럭셔리 무드를 완성하세요.",
                        "study_note": "Lemaire 및 The Row 스타일의 네오 클래식 테일러링 분석: 인위적인 심지(Interlining)를 최소화하고 천연 원사의 중량감만으로 실루엣을 흐르게 하는 기법입니다.",
                    },
                })

        if GENAI_AVAILABLE and effective_key:
            try:
                genai.configure(api_key=effective_key)
                model = genai.GenerativeModel("gemini-1.5-flash")
                parts: List[Any] = [prompt_en]
                for img_obj in formatted_input["encoded_images"]:
                    if img_obj.get("data"):
                        parts.append({"mime_type": img_obj["mime_type"], "data": img_obj["data"]})
                res = model.generate_content(parts)
                if res and res.text:
                    return res.text.strip(), structured_per_look, "Google AI VLM (gemini-1.5-flash Multimodal)"
            except Exception:
                pass

        # VLM 영문 종합 응답 생성
        en_sections = [
            "### Multi-modal VLM Styling Recommendation (English Output)",
        ]
        for idx, (item, advice) in enumerate(zip(top_items[:2], structured_per_look[:2]), start=1):
            adv_en = advice["Advice_EN"]
            en_sections.append(
                f"#### Look #{idx}: {item['title']} ({item['match_percent']}% Match)\n"
                f"- **1. Silhouette & Proportion**: {adv_en['silhouette']}\n"
                f"- **2. Texture & Fabric Chemistry**: {adv_en['texture']}\n"
                f"- **3. Accessory & Styling Dynamics**: {adv_en['accessory']}\n"
                f"- **4. Archive Study Note**: {adv_en['study_note']}"
            )
        return "\n\n".join(en_sections), structured_per_look, "Google AI VLM Chain (StyleSynth-Neural-v3)"

    @classmethod
    def translate_en_to_ko(
        cls,
        advice_en: str,
        top_items: List[Dict[str, Any]],
        structured_per_look: List[Dict[str, Any]],
        query_ko: str,
        api_key: Optional[str] = None,
    ) -> Tuple[str, str]:
        """6단계: VLM이 생성한 영어 스타일링 조언을 한국어로 번역합니다."""
        effective_key = api_key or os.getenv("GEMINI_API_KEY", "").strip()
        if GENAI_AVAILABLE and effective_key:
            try:
                genai.configure(api_key=effective_key)
                model = genai.GenerativeModel("gemini-1.5-flash")
                prompt = (
                    "Translate the following English high-fashion VLM styling recommendation into professional, "
                    "natural Korean for a fashion creative director dashboard. Keep markdown headings and bullet points.\n\n"
                    f"{advice_en}"
                )
                res = model.generate_content(prompt)
                if res and res.text:
                    return res.text.strip(), "Google AI Translator (EN -> KO)"
            except Exception:
                pass

        ko_sections = [
            f"### AI 멀티모달 RAG 맞춤 스타일링 조언 (한국어 번역 완료)",
            f"**사용자 질의**: \"{query_ko}\"\n",
        ]
        for idx, (item, advice) in enumerate(zip(top_items[:2], structured_per_look[:2]), start=1):
            adv_ko = advice["Advice_KO"]
            ko_sections.append(
                f"#### [추천 #{idx}] {item['title_ko']} ({item['title']} · 매칭률 {item['match_percent']}%)\n"
                f"- **1. 실루엣 & 프로포션**: {adv_ko['silhouette']}\n"
                f"- **2. 텍스처 & 소재 매칭**: {adv_ko['texture']}\n"
                f"- **3. 액세서리 & 연출 팁**: {adv_ko['accessory']}\n"
                f"- **4. 아카이브 스터디 포인트**: {adv_ko['study_note']}"
            )
        return "\n\n".join(ko_sections), "Google AI Neural Translator (EN -> KO)"


