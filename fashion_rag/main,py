# 3. 이미지 인코딩(Base64) 및 이미지 청킹(Image Chunking) 유틸리티
# ==============================================================================
class ImageChunker:
    """
    패션 룩 이미지를 Base64로 인코딩하고, 멀티모달 RAG를 위해
    [전신 실루엣 / 상의·아우터 / 하의·드레이프 / 원단 텍스처] 패치 단위로 이미지 청킹을 수행합니다.
    """

    @staticmethod
    def _create_rgb_png_base64(hex_colors: List[str], width: int = 96, height: int = 128) -> str:
        """외부 라이브러리 의존 없이 순수 표준 라이브러리(zlib)로 유효한 PNG 바이트 및 Base64를 생성합니다."""
        rgb_list: List[Tuple[int, int, int]] = []
        for h in hex_colors:
            clean = h.lstrip("#")
            if len(clean) == 6:
                rgb_list.append((int(clean[0:2], 16), int(clean[2:4], 16), int(clean[4:6], 16)))
        if not rgb_list:
            rgb_list = [(28, 31, 42), (139, 92, 246), (16, 185, 129)]

        raw_rows = bytearray()
        for y in range(height):
            raw_rows.append(0)  # PNG filter type 0
            band = min(len(rgb_list) - 1, int((y / max(1, height)) * len(rgb_list)))
            r, g, b = rgb_list[band]
            for x in range(width):
                shade = int(((x / max(1, width)) - 0.5) * 18)
                raw_rows.extend((
                    max(0, min(255, r + shade)),
                    max(0, min(255, g + shade)),
                    max(0, min(255, b + shade)),
                ))

        def make_chunk(chunk_type: bytes, data: bytes) -> bytes:
            crc = zlib.crc32(chunk_type + data) & 0xFFFFFFFF
            return len(data).to_bytes(4, "big") + chunk_type + data + crc.to_bytes(4, "big")

        ihdr = (
            width.to_bytes(4, "big")
            + height.to_bytes(4, "big")
            + bytes([8, 2, 0, 0, 0])  # 8-bit RGB
        )
        idat = zlib.compress(bytes(raw_rows), level=6)
        png_bytes = (
            b"\x89PNG\r\n\x1a\n"
            + make_chunk(b"IHDR", ihdr)
            + make_chunk(b"IDAT", idat)
            + make_chunk(b"IEND", b"")
        )
        return base64.b64encode(png_bytes).decode("utf-8")

    @classmethod
    def chunk_and_encode_item(cls, item: Dict[str, Any]) -> Dict[str, Any]:
        """
        패션 아이템의 대표 이미지(또는 업로드된 Base64 이미지)를
        전신 Base64와 3개의 의미론적 이미지 청크(Upper, Lower, Texture Patch)로 분할합니다.
        """
        swatches = item.get("fashionpedia_taxonomy", {}).get("swatches", [])
        hexes = [s.get("hex", "#1E293B") for s in swatches] or ["#1B263B", "#3D405B", "#0D1B2A"]

        raw_b64 = item.get("image_base64")
        if raw_b64 and "," in raw_b64:
            raw_b64 = raw_b64.split(",", 1)[1]

        # PIL이 설치되어 있고 원본 이미지 바이트가 제공된 경우 실제 이미지 크롭 청킹 수행
        if PIL_AVAILABLE and raw_b64:
            try:
                img_bytes = base64.b64decode(raw_b64)
                with Image.open(io.BytesIO(img_bytes)) as img:
                    img = img.convert("RGB")
                    w, h = img.size
                    regions = [
                        ("chunk_upper", "Upper Silhouette & Lapel/Outerwear", (0, 0, w, int(h * 0.55))),
                        ("chunk_lower", "Lower Drape & Trousers/Pleats", (0, int(h * 0.45), w, h)),
                        ("chunk_texture", "Center Fabric Weave & Hardware Patch", (int(w * 0.25), int(h * 0.25), int(w * 0.75), int(h * 0.75))),
                    ]
                    chunks = []
                    for cid, label, box in regions:
                        cropped = img.crop(box).resize((96, 96))
                        buf = io.BytesIO()
                        cropped.save(buf, format="PNG")
                        cb64 = base64.b64encode(buf.getvalue()).decode("utf-8")
                        chunks.append({
                            "chunk_id": f"{item['item_id']}_{cid}",
                            "region": cid,
                            "label": label,
                            "base64_png": cb64,
                            "description": f"{item.get('title', 'Look')} - {label}",
                        })
                    return {"full_base64": raw_b64, "chunks": chunks}
            except Exception:
                pass

        # 기본 카탈로그 또는 PIL 미설치 환경: 스와치 팔레트 기반 유효한 PNG Base64 및 3개 패치 청크 생성
        full_b64 = raw_b64 or cls._create_rgb_png_base64(hexes, width=96, height=128)
        chunk_defs = [
            (
                "chunk_upper",
                "Upper Silhouette & Outerwear Construction",
                [hexes[0], hexes[min(1, len(hexes) - 1)]],
                f"{item.get('title')}: Upper garment construction, shoulder line, and collar/lapel structure.",
            ),
            (
                "chunk_lower",
                "Lower Proportion & Trousers Drape",
                [hexes[min(1, len(hexes) - 1)], hexes[-1]],
                f"{item.get('title')}: Lower silhouette volume, pleat balance, and footwear anchoring.",
            ),
            (
                "chunk_texture",
                "Micro-Texture & Fabric Chemistry Patch",
                [hexes[-1], hexes[0]],
                f"{item.get('title')}: Fabric density ({item.get('fashionpedia_taxonomy', {}).get('fabric_chemistry', 'High-density weave')}).",
            ),
        ]
        chunks = []
        for cid, label, c_hexes, desc in chunk_defs:
            chunks.append({
                "chunk_id": f"{item['item_id']}_{cid}",
                "region": cid,
                "label": label,
                "base64_png": cls._create_rgb_png_base64(c_hexes, width=64, height=64),
                "description": desc,
            })
        return {"full_base64": full_b64, "chunks": chunks}


