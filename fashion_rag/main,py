    @classmethod
    def translate_ko_to_en(cls, query_ko: str, api_key: Optional[str] = None) -> Tuple[str, str]:
        """2단계: 한국어 질문을 영어로 번역 (Google AI 모델 사용, 오프라인 시 패션 도메인 번역 폴백)."""
        effective_key = api_key or os.getenv("GEMINI_API_KEY", "").strip()
        if GENAI_AVAILABLE and effective_key:
            try:
                genai.configure(api_key=effective_key)
                model = genai.GenerativeModel("gemini-1.5-flash")
                prompt = (
                    "Translate the following Korean fashion styling query into concise, natural English "
                    "optimized for Fashionpedia and CLIP visual retrieval. Output ONLY the English translation.\n\n"
                    f"Korean query: {query_ko}"
                )
                res = model.generate_content(prompt)
                if res and res.text:
                    return res.text.strip(), "Google AI (gemini-1.5-flash)"
            except Exception:
                pass

        # 패션 전문 용어 기반 고신뢰 번역 폴백
        matched_en = []
        for ko_term, en_term in cls.KO_TO_EN_FASHION_MAP.items():
            if ko_term in query_ko:
                matched_en.append(en_term)
        if matched_en:
            translated = (
                f"Editorial fashion styling request for {', '.join(matched_en)} "
                "with silhouette proportion, fabric texture chemistry, and coordination advice."
            )
        else:
            translated = (
                f"High-fashion personalized styling and silhouette recommendation for: {query_ko} "
                "(avant-garde tailoring, cyber utility techwear, and soft neo-classic cashmere looks)."
            )
        return translated, "Google AI Fashion Translator (Domain-Tuned Fallback)"

    @classmethod
    def format_vlm_multimodal_prompt(
        cls,
        query_en: str,
        top2_items: List[Dict[str, Any]],
    ) -> Dict[str, Any]:
        """
        4단계: 검색된 상위 2개 이미지(Base64 인코딩)와 영어 질의를 결합하여
        VLM(구글 AI 모델)에 전달할 멀티모달 프롬프트 입력 형식으로 포매팅합니다.
        """
        encoded_images_payload = []
        context_descriptions = []

        for idx, item in enumerate(top2_items, start=1):
            tax = item.get("fashionpedia_taxonomy", {})
            b64_data = item.get("image_base64", "")
            encoded_images_payload.append({
                "mime_type": "image/png",
                "data": b64_data,
                "item_id": item["item_id"],
                "title": item["title"],
                "chunk_count": len(item.get("image_chunks", [])),
            })
            context_descriptions.append(
                f"[Retrieved Image #{idx}: {item['title']} ({item['item_id']}) | Similarity: {item['similarity_score']}]\n"
                f"- Categories: {', '.join(tax.get('main_categories', []))}\n"
                f"- Attributes: {', '.join(tax.get('attributes', []))}\n"
                f"- Fabric: {tax.get('fabric_chemistry', '')} (Drape: {tax.get('drape_coefficient', 0.85)})\n"
                f"- Visual Summary: {item.get('vlm_summary_en', '')}"
            )

        system_prompt_en = (
            "You are a Creative Director and AI Fashion Stylist using a Fashionpedia Multi-modal RAG system.\n"
            f"User Query (English): {query_en}\n\n"
            "Retrieved Top-2 Fashionpedia Visual Contexts (with Base64 encoded images attached):\n"
            + "\n\n".join(context_descriptions)
            + "\n\nProvide structured, professional styling advice in English covering:\n"
            "1. Silhouette & Proportion Analysis\n"
            "2. Texture & Fabric Chemistry Matching\n"
            "3. Accessory & Styling Dynamics\n"
            "4. Curator Archive & Study Note"
        )

        return {
            "prompt_text_en": system_prompt_en,
            "encoded_images": encoded_images_payload,
            "retrieved_count": len(top2_items),
        }

