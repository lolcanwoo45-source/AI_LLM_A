@app.post("/ingest")
async def ingest_fashion_dataset(req: IngestRequest):
    """Fashionpedia 데이터셋 초기화 또는 사용자 정의 패션 이미지를 청킹하여 ChromaDB에 인덱싱합니다."""
    stream = StreamHandler("FASHIONPEDIA_MULTIVECTOR_INGEST")
    try:
        stream.emit(
            step="IMAGE_CHUNKING",
            message=f"'{req.filename}' 이미지 청킹(Upper/Lower/Texture) 및 Base64 인코딩 수행 중...",
            status="RUNNING",
            progress=30,
            time_complexity="O(W * H)",
            space_complexity="O(C * P)",
        )

        if req.reset_index:
            fashion_store.seed_default_fashionpedia(reset=True)

        if req.raw_text or req.image_base64 or req.title:
            custom_id = f"FP-LOOK-{len(fashion_store.parent_store) + 1:02d}"
            custom_title = req.title or req.filename.rsplit(".", 1)[0]
            custom_item = {
                "item_id": custom_id,
                "title": custom_title,
                "title_ko": custom_title,
                "category": req.category or "Custom Editorial Look",
                "image_base64": req.image_base64 or req.pdf_base64,
                "image_url": FASHIONPEDIA_DEFAULT_CATALOG[0]["image_url"],
                "vlm_summary_en": req.raw_text or f"Custom Fashionpedia look: {custom_title}",
                "summary_ko": req.raw_text or f"사용자 추가 패션 룩: {custom_title}",
                "keywords": (req.raw_text or custom_title).split(),
                "fashionpedia_taxonomy": FASHIONPEDIA_DEFAULT_CATALOG[0]["fashionpedia_taxonomy"],
            }
            fashion_store.index_fashion_item(custom_item)

        stats = fashion_store.get_stats()
        stream.emit(
            step="CHROMADB_MULTIVECTOR_INDEX",
            message=f"ChromaDB 다중벡터 인덱싱 완료 (총 {stats['parent_look_count']}개 룩, {stats['total_multi_vectors']}개 멀티벡터)",
            status="SUCCESS",
            progress=100,
            time_complexity="O(N * d)",
            space_complexity="O(N * d)",
            details=stats,
        )

        return {
            "status": "SUCCESS",
            "message": "Fashionpedia 멀티모달 데이터셋 및 이미지 청크가 ChromaDB에 인덱싱되었습니다.",
            "file_info": {"filename": req.filename},
            "index_info": stats,
            "complexity_metrics": {"time": "O(N * d)", "space": "O(N * d)"},
            "stream_logs": stream.get_summary(),
        }
    except Exception as exc:
        return JSONResponse(
            status_code=500,
            content={
                "status": "ERROR",
                "error_code": "INGEST_FAILED",
                "message": f"ChromaDB 인덱싱 중 오류 발생: {exc}",
                "traceback": traceback.format_exc(),
                "stream_logs": stream.get_summary(),
            },
        )


@app.post("/query")
@app.post("/api/v1/style-synthesize")
async def execute_multimodal_fashion_rag(req: QueryRequest):
    """
    [메인 멀티모달 RAG 파이프라인 엔드포인트]
    1. 한국어 질의 입력 -> 2. 영문 번역(Google AI) -> 3. 상위 2개 유사 이미지 검색(ChromaDB Multi-Vector)
    -> 4. Base64 이미지 인코딩 & 프롬프트 포매팅 -> 5. VLM 영문 스타일링 조언 생성
    -> 6. 한국어 번역 -> 7. 추천 이미지 및 스타일링 조언 반환
    """
    stream = StreamHandler("MULTIMODAL_FASHION_RAG_CHAIN")
    try:
        query_ko = req.query.strip()
        # Step 1: 한국어 질의 수신
        stream.emit(
            step="STEP_1_QUERY_INPUT",
            message=f"[1단계] 한국어 사용자 질의 수신: '{query_ko}'",
            status="RUNNING",
            progress=15,
            time_complexity="O(L)",
            space_complexity="O(L)",
            details={"query_ko": query_ko, "has_image_query": bool(req.image_base64)},
        )

        # Step 2: 한국어 질문 -> 영어 번역 (Google AI)
        query_en, trans_ko_en_model = MultiModalRAGChain.translate_ko_to_en(query_ko, api_key=req.api_key)
        stream.emit(
            step="STEP_2_QUERY_TRANSLATION_KO_EN",
            message=f"[2단계] 한국어 질의 -> 영어 번역 완료 ({trans_ko_en_model}): '{query_en}'",
            status="RUNNING",
            progress=30,
            time_complexity="O(L_tokens)",
            space_complexity="O(L_tokens)",
            details={"query_en": query_en, "model": trans_ko_en_model},
        )

        # Step 3: ChromaDB 다중벡터 검색기로 상위 2개(top_k=2) 이미지 검색 (+ 3단 비교용 전체 3종 함께 조회)
        all_ranked_looks = fashion_store.multi_vector_search(
            query_en=query_en,
            query_ko=query_ko,
            query_image_b64=req.image_base64,
            top_k=3,
        )
        top2_retrieved = all_ranked_looks[: max(1, min(2, req.top_k))]
        stream.emit(
            step="STEP_3_CHROMADB_TOP2_RETRIEVAL",
            message=f"[3단계] CLIP Joint Embedding + ChromaDB 다중벡터 검색 완료 (상위 {len(top2_retrieved)}개 핵심 이미지 도출)",
            status="RUNNING",
            progress=50,
            time_complexity="O(K * d * log N)",
            space_complexity="O(K * d)",
            details={
                "top_2_ids": [it["item_id"] for it in top2_retrieved],
                "top_2_scores": [it["similarity_score"] for it in top2_retrieved],
            },
        )

        # Step 4: 검색된 이미지 Base64 인코딩 및 VLM 프롬프트 포매팅
        formatted_vlm_input = MultiModalRAGChain.format_vlm_multimodal_prompt(
            query_en=query_en,
            top2_items=top2_retrieved,
        )
        stream.emit(
            step="STEP_4_BASE64_PROMPT_FORMATTING",
            message=f"[4단계] 상위 {len(top2_retrieved)}개 이미지 Base64 인코딩 및 VLM 멀티모달 프롬프트 포매팅 완료",
            status="RUNNING",
            progress=68,
            time_complexity="O(B_img)",
            space_complexity="O(B_img)",
            details={
                "encoded_image_count": formatted_vlm_input["retrieved_count"],
                "base64_preview_lengths": [len(img["data"]) for img in formatted_vlm_input["encoded_images"]],
            },
        )

        # Step 5: VLM 호출 -> 영어 스타일링 조언 생성
        advice_en, structured_per_look, vlm_model = MultiModalRAGChain.generate_vlm_styling_advice_en(
            formatted_input=formatted_vlm_input,
            top_items=all_ranked_looks,
            api_key=req.api_key,
        )
        stream.emit(
            step="STEP_5_VLM_STYLING_GENERATION_EN",
            message=f"[5단계] Google AI VLM 영어 스타일링 조언 생성 완료 ({vlm_model})",
            status="RUNNING",
            progress=85,
            time_complexity="O(T_gen)",
            space_complexity="O(T_gen)",
            details={"vlm_model": vlm_model, "english_length": len(advice_en)},
        )

        # Step 6: 영어 응답 -> 한국어 번역
        advice_ko, trans_en_ko_model = MultiModalRAGChain.translate_en_to_ko(
            advice_en=advice_en,
            top_items=all_ranked_looks,
            structured_per_look=structured_per_look,
            query_ko=query_ko,
            api_key=req.api_key,
        )
        stream.emit(
            step="STEP_6_RESPONSE_TRANSLATION_EN_KO",
            message=f"[6단계] 영어 스타일링 조언 -> 한국어 번역 완료 ({trans_en_ko_model})",
            status="SUCCESS",
            progress=100,
            time_complexity="O(T_trans)",
            space_complexity="O(T_trans)",
            details={"translator_model": trans_en_ko_model, "korean_length": len(advice_ko)},
        )

        # 각 룩 아이템에 한/영 4단계 스타일링 진단 병합
        advice_map = {entry["item_id"]: entry for entry in structured_per_look}
        enriched_recommendations = []
        for look in all_ranked_looks:
            adv = advice_map.get(look["item_id"], {})
            enriched_recommendations.append({
                **look,
                "styling_advice_en": adv.get("Advice_EN", {}),
                "styling_advice_ko": adv.get("Advice_KO", {}),
            })

        # Step 7: 최종 결과 출력 (기존 @code.gs 필드와 신규 멀티모달 필드 모두 호환)
        return {
            "status": "SUCCESS",
            "query": query_ko,
            "query_ko": query_ko,
            "translated_query_en": query_en,
            "top_2_retrieved_images": enriched_recommendations[:2],
            "recommendations": enriched_recommendations[:3],
            "styling_advice_en": advice_en,
            "styling_advice_ko": advice_ko,
            "llm_answer": advice_ko,
            "expanded_queries": [
                {"perspective": "원본 한국어 질의 (KO)", "query": query_ko},
                {"perspective": "Google AI 영문 번역 질의 (EN)", "query": query_en},
            ],
            "rag_results": enriched_recommendations[:2],
            "sources": [
                {
                    "item_id": r["item_id"],
                    "title": r["title"],
                    "title_ko": r["title_ko"],
                    "similarity_score": r["similarity_score"],
                    "match_percent": r["match_percent"],
                }
                for r in enriched_recommendations[:2]
            ],
            "fusion_metadata": {
                "architecture": "Fashionpedia Multi-modal RAG (CLIP + ChromaDB Multi-Vector + Google AI VLM)",
                "top_k_retrieved": len(top2_retrieved),
                "comparison_slots": len(enriched_recommendations[:3]),
            },
            "complexity_metrics": {
                "retrieval": "O(K * d * log N)",
                "vlm_generation": "O(B_img + T_tokens)",
            },
            "stream_logs": stream.get_summary(),
        }
    except Exception as exc:
        return JSONResponse(
            status_code=500,
            content={
                "status": "ERROR",
                "error_code": "MULTIMODAL_RAG_ERROR",
                "message": f"멀티모달 RAG 파이프라인 실행 중 오류 발생: {exc}",
                "traceback": traceback.format_exc(),
                "stream_logs": stream.get_summary(),
            },
        )


