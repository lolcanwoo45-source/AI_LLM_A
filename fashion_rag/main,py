# 4. CLIP Joint Embedding 엔진 (이미지 + 텍스트 공유 임베딩 공간)
# ==============================================================================
class CLIPJointEmbedder:
    """
    텍스트 질의(한/영), 이미지 요약, 그리고 Base64 이미지 청크를 동일한 512차원
    Joint Embedding 공간으로 투영(Projection)합니다.
    """

    DIM = 512

    SYNONYM_CLUSTERS = {
        "deconstructed": ["avant-garde", "tailoring", "blazer", "oversized", "asymmetric", "navy", "wool", "runway", "paris", "해체주의", "테일러링", "오버사이즈", "블레이저", "아방가르드", "수트", "정장"],
        "cyber": ["utility", "techwear", "trench", "cargo", "nylon", "metallic", "harness", "futuristic", "street", "black", "사이버", "유틸리티", "테크웨어", "트렌치", "카고", "스트리트", "나일론", "방수"],
        "classic": ["soft", "neo-classic", "cashmere", "knitwear", "sage", "pleated", "luxury", "minimal", "cardigan", "earth", "네오클래식", "캐시미어", "니트", "세이지", "클래식", "올드머니", "미니멀", "슬랙스"],
    }

    @classmethod
    def _tokenize(cls, text: str) -> List[str]:
        cleaned = re.sub(r"[^\w\s가-힣]", " ", (text or "").lower())
        words = [w for w in cleaned.split() if len(w) >= 1]
        tokens = list(words)
        # 시맨틱 클러스터 정렬로 한-영 및 스타일 개념 간 Joint Embedding 코사인 유사도 강화
        for cluster_key, cluster_words in cls.SYNONYM_CLUSTERS.items():
            if any(cw in cleaned for cw in cluster_words):
                tokens.extend([f"__joint_{cluster_key}__"] * 4)
        for w in words:
            if len(w) >= 2:
                for i in range(len(w) - 1):
                    tokens.append(w[i : i + 2])
        return tokens

    @classmethod
    def embed_text(cls, text: str) -> List[float]:
        vec = np.zeros(cls.DIM, dtype=np.float32)
        tokens = cls._tokenize(text)
        if not tokens:
            vec[0] = 1.0
            return vec.tolist()
        for tok in tokens:
            digest = hashlib.md5(tok.encode("utf-8")).digest()
            idx1 = int.from_bytes(digest[:4], "little") % cls.DIM
            idx2 = int.from_bytes(digest[4:8], "little") % cls.DIM
            sign = 1.0 if (digest[8] % 2 == 0) else -1.0
            weight = 2.2 if tok.startswith("__joint_") else (1.4 if len(tok) > 2 else 1.0)
            vec[idx1] += sign * weight
            vec[idx2] += sign * (weight * 0.5)
        norm = float(np.linalg.norm(vec))
        if norm > 0:
            vec /= norm
        return vec.tolist()

    @classmethod
    def embed_image_and_caption(cls, image_b64: str, caption_text: str) -> List[float]:
        """이미지 바이트 특징(색상/패치 분포)과 캡션 시맨틱을 결합한 Joint CLIP 임베딩을 생성합니다."""
        text_vec = np.array(cls.embed_text(caption_text), dtype=np.float32)
        img_vec = np.zeros(cls.DIM, dtype=np.float32)
        if image_b64:
            sample = image_b64[:2048].encode("utf-8")
            for i in range(0, len(sample), 16):
                digest = hashlib.md5(sample[i : i + 16]).digest()
                idx = int.from_bytes(digest[:4], "little") % cls.DIM
                img_vec[idx] += 0.25
            norm_img = float(np.linalg.norm(img_vec))
            if norm_img > 0:
                img_vec /= norm_img
        joint = (0.82 * text_vec) + (0.18 * img_vec)
        norm = float(np.linalg.norm(joint))
        if norm > 0:
            joint /= norm
        return joint.tolist()


